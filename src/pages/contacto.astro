---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { CONTACT, SITE_TITLE } from '../consts';
---

<!doctype html>
<html lang="es">
	<head>
		<BaseHead
			title={`Contacto y Ubicación | ${SITE_TITLE}`}
			description="Comunícate con sha256.us. Sede principal en Quíbor, Lara, Venezuela. Teléfonos, email y canales de atención pericial."
		/>
	</head>
	<body class="bg-base-lightest font-sans">
		<Header />
		<main id="main-content" class="padding-y-6">
			<div class="grid-container maxw-desktop margin-x-auto padding-x-2">
				<!-- Header de página -->
				<div class="margin-bottom-6 border-bottom-2px border-base-lighter padding-bottom-3">
					<span class="usa-tag bg-primary text-white margin-bottom-1">CANALES DE ATENCIÓN</span>
					<h1 class="font-sans-2xl tablet:font-sans-3xl text-bold text-primary-darker margin-top-1 margin-bottom-2">
						Contáctanos — Laboratorio sha256.us
					</h1>
					<p class="font-sans-md text-base-dark line-height-sans-4 maxw-tablet">
						Estamos a tu disposición para atender consultas, recibir dispositivos por consignación y coordinar informes periciales.
					</p>
				</div>

				<div class="grid-row grid-gap margin-bottom-8">
					<!-- Formulario de Contacto USWDS -->
					<div class="tablet:grid-col-7 margin-bottom-4 tablet:margin-bottom-0">
						<div class="bg-white padding-4 tablet:padding-6 radius-lg shadow-1 border-1px border-base-lighter">
							<h2 class="font-sans-xl text-bold text-primary-darker margin-top-0 margin-bottom-2">
								Envíanos un mensaje sobre tu caso
							</h2>
							<p class="font-sans-xs text-base-dark margin-bottom-4">
								Completa la siguiente planilla para que un perito informático evalúe tu requerimiento a la brevedad.
							</p>

							<form class="usa-form maxw-full" onsubmit="event.preventDefault(); alert('Gracias por comunicarte con sha256.us. Te contactaremos pronto.');">
								<label class="usa-label font-sans-xs text-bold" for="nombre">Nombre Completo o Empresa</label>
								<input class="usa-input width-full" id="nombre" name="nombre" type="text" required />

								<label class="usa-label font-sans-xs text-bold margin-top-2" for="email">Correo Electrónico</label>
								<input class="usa-input width-full" id="email" name="email" type="email" required />

								<label class="usa-label font-sans-xs text-bold margin-top-2" for="telefono">Teléfono / WhatsApp</label>
								<input class="usa-input width-full" id="telefono" name="telefono" type="tel" placeholder="+57 316 3931945" />

								<label class="usa-label font-sans-xs text-bold margin-top-2" for="servicio">Tipo de Evidencia o Servicio</label>
								<select class="usa-select width-full" id="servicio" name="servicio">
									<option value="movil">Peritaje de Dispositivo Móvil (WhatsApp, Audios, etc.)</option>
									<option value="disco">Reparación / Extracción de Disco o Servidor</option>
									<option value="judicial">Informe Pericial Judicial con Cadena de Custodia</option>
									<option value="otro">Otra consulta técnica</option>
								</select>

								<label class="usa-label font-sans-xs text-bold margin-top-2" for="mensaje">Detalles del caso</label>
								<textarea class="usa-textarea width-full" id="mensaje" name="mensaje" rows="4" required></textarea>

								<button class="usa-button usa-button--primary margin-top-3 width-full tablet:width-auto" type="submit">
									Enviar Requerimiento
								</button>
							</form>
						</div>
					</div>

					<!-- Datos de Contacto y Ubicación -->
					<div class="tablet:grid-col-5">
						<div class="bg-white padding-4 tablet:padding-6 radius-lg shadow-1 border-1px border-base-lighter height-full display-flex flex-column">
							<h2 class="font-sans-xl text-bold text-primary-darker margin-top-0 margin-bottom-3">
								Información Oficial
							</h2>

							<div class="margin-bottom-3">
								<span class="font-sans-3xs text-uppercase text-bold text-primary display-block margin-bottom-05">Sede Principal</span>
								<p class="font-sans-xs text-base-dark line-height-sans-3 margin-0">
									{CONTACT.address}
								</p>
							</div>

							<div class="margin-bottom-3">
								<span class="font-sans-3xs text-uppercase text-bold text-primary display-block margin-bottom-05">WhatsApp / Teléfono</span>
								<p class="font-sans-md text-base-dark margin-y-05">
									<a
										href={CONTACT.whatsapp}
										target="_blank"
										rel="noopener noreferrer"
										class="display-inline-flex flex-align-center text-bold text-no-underline hover:underline text-primary-darker"
										title="Contactar vía WhatsApp"
									>
										<svg width="20" height="20" viewBox="0 0 24 24" fill="#25D366" aria-hidden="true" style="vertical-align:middle;margin-right:6px">
											<path d="M12.04 2c-5.46 0-9.91 4.45-9.91 9.91 0 1.75.46 3.45 1.32 4.95L2.05 22l5.25-1.38c1.45.79 3.08 1.21 4.74 1.21 5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01A9.82 9.82 0 0 0 12.04 2m.01 1.67c2.2 0 4.26.86 5.82 2.42a8.23 8.23 0 0 1 2.41 5.83c0 4.54-3.7 8.24-8.24 8.24-1.48 0-2.93-.4-4.2-1.15l-.3-.18-3.12.82.83-3.04-.2-.31a8.2 8.2 0 0 1-1.26-4.38c0-4.54 3.7-8.24 8.24-8.24m4.52 11.66c-.25-.13-1.47-.72-1.7-.81-.23-.08-.39-.13-.56.13-.17.25-.64.81-.79.97-.14.17-.29.19-.54.06-.25-.13-1.06-.39-2.02-1.25-.75-.67-1.25-1.5-1.4-1.75-.15-.25-.02-.39.11-.51.11-.11.25-.29.37-.44.13-.14.17-.25.25-.42.08-.17.04-.31-.02-.44-.06-.13-.56-1.34-.76-1.84-.2-.49-.4-.42-.56-.43h-.47c-.17 0-.44.06-.67.31-.23.25-.87.85-.87 2.07 0 1.22.89 2.4 1.01 2.57.13.17 1.75 2.67 4.24 3.75.59.26 1.05.41 1.41.53.6.19 1.14.16 1.57.1.48-.07 1.47-.6 1.68-1.18.21-.58.21-1.08.15-1.18-.06-.1-.23-.17-.48-.29z"/>
										</svg>
										<span>{CONTACT.phone.display}</span>
									</a>
								</p>
							</div>

							<div class="margin-bottom-3">
								<span class="font-sans-3xs text-uppercase text-bold text-primary display-block margin-bottom-05">Correo Electrónico</span>
								<p class="font-sans-sm text-base-dark margin-0">
									<a href={`mailto:${CONTACT.email}`} class="usa-link text-bold">{CONTACT.email}</a>
								</p>
							</div>

							<div class="margin-top-auto border-top-1px border-base-lighter padding-top-3">
								<span class="font-sans-3xs text-uppercase text-bold text-base display-block margin-bottom-1">Redes Sociales Oficiales</span>
								<div class="display-flex flex-wrap gap-2">
									<a
										href={CONTACT.social.whatsapp}
										target="_blank"
										rel="noopener noreferrer"
										class="usa-button usa-button--outline font-sans-3xs padding-y-1 padding-x-2 margin-0 display-inline-flex flex-align-center gap-1"
									>
										<svg width="14" height="14" viewBox="0 0 24 24" fill="#25D366" aria-hidden="true">
											<path d="M12.04 2c-5.46 0-9.91 4.45-9.91 9.91 0 1.75.46 3.45 1.32 4.95L2.05 22l5.25-1.38c1.45.79 3.08 1.21 4.74 1.21 5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01A9.82 9.82 0 0 0 12.04 2m.01 1.67c2.2 0 4.26.86 5.82 2.42a8.23 8.23 0 0 1 2.41 5.83c0 4.54-3.7 8.24-8.24 8.24-1.48 0-2.93-.4-4.2-1.15l-.3-.18-3.12.82.83-3.04-.2-.31a8.2 8.2 0 0 1-1.26-4.38c0-4.54 3.7-8.24 8.24-8.24m4.52 11.66c-.25-.13-1.47-.72-1.7-.81-.23-.08-.39-.13-.56.13-.17.25-.64.81-.79.97-.14.17-.29.19-.54.06-.25-.13-1.06-.39-2.02-1.25-.75-.67-1.25-1.5-1.4-1.75-.15-.25-.02-.39.11-.51.11-.11.25-.29.37-.44.13-.14.17-.25.25-.42.08-.17.04-.31-.02-.44-.06-.13-.56-1.34-.76-1.84-.2-.49-.4-.42-.56-.43h-.47c-.17 0-.44.06-.67.31-.23.25-.87.85-.87 2.07 0 1.22.89 2.4 1.01 2.57.13.17 1.75 2.67 4.24 3.75.59.26 1.05.41 1.41.53.6.19 1.14.16 1.57.1.48-.07 1.47-.6 1.68-1.18.21-.58.21-1.08.15-1.18-.06-.1-.23-.17-.48-.29z"/>
										</svg>
										<span>WhatsApp</span>
									</a>
									<a
										href={CONTACT.social.linkedin}
										target="_blank"
										rel="noopener noreferrer"
										class="usa-button usa-button--outline font-sans-3xs padding-y-1 padding-x-2 margin-0 display-inline-flex flex-align-center gap-1"
									>
										<svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
											<path d="M19 3a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h14m-.5 15.5v-5.3a3.26 3.26 0 0 0-3.26-3.26c-.85 0-1.84.52-2.28 1.3v-1.11h-2.79v8.37h2.79v-4.93c0-.77.62-1.4 1.39-1.4a1.4 1.4 0 0 1 1.4 1.4v4.93h2.75M6.46 8.76a1.69 1.69 0 1 0 0-3.38 1.69 1.69 0 0 0 0 3.38m1.39 9.74v-8.37H5.07v8.37h2.78z"/>
										</svg>
										<span>LinkedIn</span>
									</a>
									<a
										href={CONTACT.social.twitter}
										target="_blank"
										rel="noopener noreferrer"
										class="usa-button usa-button--outline font-sans-3xs padding-y-1 padding-x-2 margin-0 display-inline-flex flex-align-center gap-1"
									>
										<svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
											<path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
										</svg>
										<span>X</span>
									</a>
									<a
										href={CONTACT.social.instagram}
										target="_blank"
										rel="noopener noreferrer"
										class="usa-button usa-button--outline font-sans-3xs padding-y-1 padding-x-2 margin-0 display-inline-flex flex-align-center gap-1"
									>
										<svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
											<path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
										</svg>
										<span>Instagram</span>
									</a>
								</div>
							</div>
						</div>
					</div>
				</div>
			</div>
		</main>
		<Footer />
	</body>
</html>

