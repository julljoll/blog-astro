---
import HeaderLink from './HeaderLink.astro';
import { CONTACT } from '../consts';

const navItems = [
  { href: '/', label: 'Inicio' },
  { href: '/servicios', label: 'Servicios Forenses' },
  { href: '/blog', label: 'Blog & Casos' },
  { href: '/about', label: 'Sobre Nosotros' },
  { href: '/contacto', label: 'Contacto' },
];
---

<!-- USWDS Official Banner -->
<section class="usa-banner" aria-label="Portal oficial sha256.us">
  <div class="usa-banner__header sha-banner__header">
    <div class="usa-banner__inner sha-banner__inner">
      <div class="grid-col-auto margin-right-1">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" class="text-primary margin-top-neg-05" style="vertical-align:middle">
          <path d="M12 1L3 5v6c0 5.55 3.84 10.74 9 12 5.16-1.26 9-6.45 9-12V5l-9-4z"/>
        </svg>
      </div>
      <div class="grid-col-fill">
        <p class="usa-banner__header-text">
          <strong>sha256.us</strong> — Portal Oficial de Informática Forense Digital &bull; Evidencia Jurídica Certificada &bull; Quíbor, Venezuela
        </p>
      </div>
      <div class="grid-col-auto display-none tablet:display-flex flex-align-center">
        <a href={`tel:${CONTACT.phones[0].link.replace('tel:','')}`} class="sha-banner__contact margin-right-2">
          <svg width="13" height="13" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" style="vertical-align:middle;margin-right:3px">
            <path d="M6.62 10.79c1.44 2.83 3.76 5.14 6.59 6.59l2.2-2.2c.27-.27.67-.36 1.02-.24 1.12.37 2.33.57 3.57.57.55 0 1 .45 1 1V20c0 .55-.45 1-1 1-9.39 0-17-7.61-17-17 0-.55.45-1 1-1h3.5c.55 0 1 .45 1 1 0 1.25.2 2.45.57 3.57.11.35.03.74-.25 1.02l-2.2 2.2z"/>
          </svg>
          {CONTACT.phones[0].display}
        </a>
        <a href={`mailto:${CONTACT.email}`} class="sha-banner__contact">
          <svg width="13" height="13" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" style="vertical-align:middle;margin-right:3px">
            <path d="M20 4H4c-1.1 0-1.99.9-1.99 2L2 18c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 4l-8 5-8-5V6l8 5 8-5v2z"/>
          </svg>
          {CONTACT.email}
        </a>
      </div>
    </div>
  </div>
</section>

<!-- Main Header -->
<header class="usa-header sha-header" id="site-header">
  <div class="sha-header__inner">
    <!-- Logo Row -->
    <div class="sha-header__logo-row">
      <div class="sha-header__logo-wrap">
        <a href="/" title="sha256.us - Inicio" class="sha-header__logo-link">
          <img
            src="/logo-head.svg"
            alt="sha256.us"
            class="sha-header__logo-img"
            onerror="this.onerror=null; this.src='/logo-head.png';"
          />
          <span class="sha-header__logo-text">
            <span class="sha-header__logo-name">sha256.us</span>
            <span class="sha-header__logo-tagline">Laboratorio Forense Digital</span>
          </span>
        </a>
      </div>

      <!-- Top-right actions -->
      <div class="sha-header__actions">
        <a href="/contacto" class="usa-button usa-button--primary sha-header__cta">
          Solicitar Peritaje
        </a>
        <!-- Mobile menu toggle -->
        <button
          class="sha-header__menu-toggle"
          id="mobileMenuToggle"
          aria-controls="mobileNav"
          aria-expanded="false"
          aria-label="Abrir menú"
        >
          <span class="sha-hamburger" id="hamburgerIcon" aria-hidden="true">
            <span></span><span></span><span></span>
          </span>
        </button>
      </div>
    </div>

    <!-- Navigation Row -->
    <nav class="sha-header__nav" aria-label="Navegación principal" id="mobileNav">
      <ul class="sha-nav__list">
        {navItems.map((item) => (
          <li class="sha-nav__item">
            <HeaderLink href={item.href} class="sha-nav__link">{item.label}</HeaderLink>
          </li>
        ))}
      </ul>
      <!-- Nav secondary: standards badge -->
      <div class="sha-nav__badges display-none tablet:display-flex">
        <span class="sha-badge">ISO/IEC 27037</span>
        <span class="sha-badge">NIST SP 800</span>
        <span class="sha-badge sha-badge--accent">MUCC-2017</span>
      </div>
    </nav>
  </div>
</header>

<style>
  /* ====== BANNER ====== */
  .sha-banner__header {
    background-color: #1a2b4b;
    color: rgba(255,255,255,0.85);
    padding: 0.35rem 0;
    font-size: 0.72rem;
  }
  .sha-banner__inner {
    display: flex;
    align-items: center;
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 1.25rem;
    gap: 0.5rem;
  }
  .usa-banner__header-text {
    font-size: 0.72rem;
    color: rgba(255,255,255,0.82);
    margin: 0;
  }
  .sha-banner__contact {
    font-size: 0.7rem;
    color: rgba(255,255,255,0.78);
    text-decoration: none;
    white-space: nowrap;
    transition: color 0.2s;
  }
  .sha-banner__contact:hover { color: #fff; }

  /* ====== MAIN HEADER ====== */
  .sha-header {
    background: #fff;
    border-bottom: 3px solid #005ea2;
    box-shadow: 0 2px 8px rgba(0,0,0,0.10);
    position: sticky;
    top: 0;
    z-index: 100;
    width: 100%;
  }
  .sha-header__inner {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 1.25rem;
  }

  /* Logo Row */
  .sha-header__logo-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.875rem 0;
    border-bottom: 1px solid #e1e7ee;
  }
  .sha-header__logo-wrap { display: flex; align-items: center; }
  .sha-header__logo-link {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    text-decoration: none;
  }
  .sha-header__logo-img {
    height: 48px;
    width: auto;
    object-fit: contain;
  }
  .sha-header__logo-text {
    display: flex;
    flex-direction: column;
    line-height: 1.2;
  }
  .sha-header__logo-name {
    font-size: 1.2rem;
    font-weight: 700;
    color: #1a2b4b;
    letter-spacing: -0.01em;
  }
  .sha-header__logo-tagline {
    font-size: 0.65rem;
    color: #71767a;
    text-transform: uppercase;
    letter-spacing: 0.07em;
    font-weight: 600;
  }

  /* Top-right actions */
  .sha-header__actions {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }
  .sha-header__cta {
    font-size: 0.8rem;
    padding: 0.5rem 1rem;
    white-space: nowrap;
  }

  /* ====== NAV ROW ====== */
  .sha-header__nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  .sha-nav__list {
    display: flex;
    list-style: none;
    margin: 0;
    padding: 0;
    gap: 0;
  }
  .sha-nav__item { position: relative; }

  /* Nav Links */
  :global(.sha-nav__link) {
    display: block;
    padding: 0.75rem 1rem;
    font-size: 0.875rem;
    font-weight: 600;
    color: #1a2b4b;
    text-decoration: none;
    border-bottom: 3px solid transparent;
    transition: color 0.2s, border-color 0.2s;
    white-space: nowrap;
  }
  :global(.sha-nav__link:hover) {
    color: #005ea2;
    border-bottom-color: #005ea2;
    background: rgba(0,94,162,0.04);
  }
  :global(.sha-nav__link.active) {
    color: #005ea2;
    border-bottom-color: #005ea2;
    font-weight: 700;
    text-decoration: none !important;
  }

  /* Badges */
  .sha-nav__badges {
    display: flex;
    gap: 0.4rem;
    align-items: center;
    padding: 0.5rem 0;
  }
  .sha-badge {
    font-size: 0.6rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    padding: 0.2rem 0.5rem;
    background: #dfe1e2;
    color: #1b1b1b;
    border-radius: 2px;
    white-space: nowrap;
  }
  .sha-badge--accent {
    background: #e41d3d;
    color: #fff;
  }

  /* ====== MOBILE MENU TOGGLE ====== */
  .sha-header__menu-toggle {
    display: none;
    background: none;
    border: 2px solid #005ea2;
    cursor: pointer;
    padding: 0.4rem;
    border-radius: 2px;
    align-items: center;
    justify-content: center;
  }
  .sha-hamburger {
    display: flex;
    flex-direction: column;
    gap: 4px;
    width: 22px;
  }
  .sha-hamburger span {
    display: block;
    height: 2px;
    background: #005ea2;
    border-radius: 1px;
    transition: transform 0.25s, opacity 0.2s;
  }

  /* Mobile styles */
  @media (max-width: 767px) {
    .sha-header__cta { display: none; }
    .sha-header__menu-toggle { display: flex; }
    .sha-header__logo-img { height: 38px; }
    .sha-header__logo-name { font-size: 1rem; }

    .sha-header__nav {
      display: none;
      flex-direction: column;
      align-items: stretch;
      background: #fff;
      border-top: 1px solid #e1e7ee;
      padding: 0.5rem 0;
    }
    .sha-header__nav.is-open { display: flex; }
    .sha-nav__list { flex-direction: column; }
    :global(.sha-nav__link) {
      padding: 0.875rem 1rem;
      border-bottom: 1px solid #f0f2f5;
      border-left: 4px solid transparent;
    }
    :global(.sha-nav__link.active) {
      border-left-color: #005ea2;
      border-bottom-color: transparent;
      background: rgba(0,94,162,0.04);
    }
    .sha-nav__badges { display: none !important; }
  }
</style>

<script>
  (function() {
    const toggle = document.getElementById('mobileMenuToggle');
    const nav = document.getElementById('mobileNav');
    const icon = document.getElementById('hamburgerIcon');

    if (!toggle || !nav) return;

    toggle.addEventListener('click', () => {
      const isOpen = nav.classList.toggle('is-open');
      toggle.setAttribute('aria-expanded', isOpen ? 'true' : 'false');
      toggle.setAttribute('aria-label', isOpen ? 'Cerrar menú' : 'Abrir menú');
      if (icon) {
        const spans = icon.querySelectorAll('span');
        if (isOpen) {
          (spans[0] as HTMLElement).style.transform = 'translateY(6px) rotate(45deg)';
          (spans[1] as HTMLElement).style.opacity = '0';
          (spans[2] as HTMLElement).style.transform = 'translateY(-6px) rotate(-45deg)';
        } else {
          spans.forEach((s: Element) => {
            (s as HTMLElement).style.transform = '';
            (s as HTMLElement).style.opacity = '';
          });
        }
      }
    });
  })();
</script>
