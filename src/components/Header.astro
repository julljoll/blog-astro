---
import HeaderLink from './HeaderLink.astro';
---

<!-- USWDS Official Banner (Government / Security Standard Style) -->
<section class="usa-banner" aria-label="Aviso oficial">
	<div class="usa-accordion">
		<header class="usa-banner__header">
			<div class="usa-banner__inner">
				<div class="grid-col-auto">
					<span class="usa-tag bg-primary-dark text-white margin-right-1">sha256.us</span>
				</div>
				<div class="grid-col-fill tablet:grid-col-auto">
					<p class="usa-banner__header-text">
						Portal Oficial de Análisis Forense Digital y Ciberseguridad
					</p>
				</div>
			</div>
		</header>
	</div>
</section>

<!-- USWDS Header -->
<header class="usa-header usa-header--basic border-bottom-1px border-base-light bg-white">
	<div class="usa-nav-container maxw-desktop margin-x-auto padding-x-2">
		<div class="usa-navbar">
			<div class="usa-logo" id="basic-logo">
				<em class="usa-logo__text">
					<a href="/" title="Inicio - sha256.us" class="text-primary text-no-underline font-sans-lg text-bold display-flex flex-align-center">
						<svg class="margin-right-1" width="28" height="28" viewBox="0 0 24 24" fill="currentColor">
							<path d="M12 1L3 5v6c0 5.55 3.84 10.74 9 12 5.16-1.26 9-6.45 9-12V5l-9-4zm0 10.99h7c-.53 4.12-3.28 7.79-7 8.94V12H5V6.3l7-3.11v8.8z"/>
						</svg>
						sha256.us
					</a>
				</em>
			</div>
			<button type="button" class="usa-menu-btn display-none">Menu</button>
		</div>
		<nav aria-label="Navegación primaria" class="usa-nav">
			<ul class="usa-nav__primary usa-accordion">
				<li class="usa-nav__primary-item">
					<HeaderLink href="/" class="usa-nav__link">Inicio</HeaderLink>
				</li>
				<li class="usa-nav__primary-item">
					<HeaderLink href="/blog" class="usa-nav__link">Blog & Casos</HeaderLink>
				</li>
				<li class="usa-nav__primary-item">
					<HeaderLink href="/about" class="usa-nav__link">Sobre Nosotros</HeaderLink>
				</li>
			</ul>
		</nav>
	</div>
</header>
